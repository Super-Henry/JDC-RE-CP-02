config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'

# swap 分区 p5
config swap
	option device '/dev/mmcblk0p5'
	option enabled '1'

# overlay 分区 p6
config mount
	option target '/overlay'
	option device '/dev/mmcblk0p6'
	option enabled '1'
	option fstype 'ext4'
	option options 'rw,sync'
	option enabled_fsck '1'
